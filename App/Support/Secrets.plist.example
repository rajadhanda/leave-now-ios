<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for App/Support/Secrets.plist (which is git-ignored).
  Copy this file to Secrets.plist and fill in your own credentials.
  NEVER commit real keys.

  Empty values are treated as "not configured": the app falls back to keyless
  TfL access (rate-limited) and disables the optional rail/traffic providers.

  REALTIMETRAINS_TOKEN is a next-gen RTT (https://data.rtt.io) Bearer token.
  RTT's terms forbid shipping a token inside a distributed app - dev builds
  only; production must proxy RTT server-side.
-->
<plist version="1.0">
<dict>
	<key>TFL_APP_KEY</key>
	<string></string>
	<key>OPENWEATHER_API_KEY</key>
	<string></string>
	<key>REALTIMETRAINS_BASE_URL</key>
	<string>https://data.rtt.io</string>
	<key>REALTIMETRAINS_TOKEN</key>
	<string></string>
	<key>HERE_API_KEY</key>
	<string></string>
	<key>GOOGLE_MAPS_API_KEY</key>
	<string></string>
</dict>
</plist>
