<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for App/Support/Secrets.plist (which is git-ignored).
  Copy this file to Secrets.plist and fill in your own credentials.
  NEVER commit real keys. All values below are placeholders.
-->
<plist version="1.0">
<dict>
	<key>TFL_APP_ID</key>
	<string>your-tfl-app-id</string>
	<key>TFL_APP_KEY</key>
	<string>your-tfl-app-key</string>
	<key>OPENWEATHER_API_KEY</key>
	<string>your-openweather-key</string>
	<key>REALTIMETRAINS_BASE_URL</key>
	<string>https://api.realtimetrains.co.uk</string>
	<key>REALTIMETRAINS_API_KEY</key>
	<string>your-realtimetrains-api-key</string>
	<key>REALTIMETRAINS_USERNAME</key>
	<string>your-realtimetrains-username</string>
	<key>REALTIMETRAINS_PASSWORD</key>
	<string>your-realtimetrains-password</string>
	<key>HERE_API_KEY</key>
	<string>your-here-api-key</string>
	<key>GOOGLE_MAPS_API_KEY</key>
	<string>your-google-maps-api-key</string>
</dict>
</plist>
